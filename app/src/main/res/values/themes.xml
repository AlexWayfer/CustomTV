<resources>
    <style name="Theme.CustomTV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/twitch_purple</item>
        <item name="colorPrimaryVariant">@color/twitch_bg</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/twitch_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/twitch_bg</item>
        <item name="android:navigationBarColor">@color/twitch_bg</item>
        <item name="android:windowBackground">@color/twitch_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.CustomTV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/twitch_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CustomTV</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/twitch_bg</item>
        <item name="android:navigationBarColor">@color/twitch_bg</item>
    </style>
</resources>
